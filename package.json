{
  "name": "eval-genius",
  "version": "0.1.3",
  "type": "module",
  "license": "MIT",
  "repository": "https://github.com/chrbala/eval-genius",
  "exports": {
    ".": {
      "types": "./dist/genius.d.ts",
      "import": "./dist/eval-genius.js",
      "require": "./dist/eval-genius.cjs"
    },
    "./exporters/google-sheets-exporter": {
      "types": "./dist/GoogleSheetsExporter.d.ts",
      "import": "./dist/exporters/google-sheets-exporter.js",
      "require": "./dist/exporters/google-sheets-exporter.cjs"
    }
  },
  "keywords": [
    "eval",
    "llm",
    "ai",
    "evaluation",
    "evals"
  ],
  "files": [
    "dist/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "eval": "vitest",
    "release:interactive": "yarn build && yarn publish",
    "release": "yarn run release:interactive --patch",
    "release:minor": "yarn run release:interactive --minor",
    "release:major": "yarn run release:interactive --major",
    "release:rc": "yarn run release:interactive --prepatch --tag=rc"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "dotenv": "^17.2.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-node": "^7.0.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@googleapis/drive": "^14.1.0",
    "google-auth-library": "^10.2.0",
    "google-spreadsheet": "^4.1.5"
  },
  "peerDependencies": {
    "vitest": "^3"
  }
}
